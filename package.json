{
  "name": "@react-lgpd-consent/workspace",
  "private": true,
  "version": "0.5.4",
  "type": "module",
  "description": "Workspace PNPM para os pacotes react-lgpd-consent.",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "clean": "turbo run clean",
    "build": "turbo run build",
    "build:core": "turbo run build --filter=@react-lgpd-consent/core",
    "build:mui": "turbo run build --filter=@react-lgpd-consent/mui",
    "build:main": "turbo run build --filter=react-lgpd-consent",
    "dev": "turbo run dev --filter=react-lgpd-consent",
    "lint": "turbo run lint",
    "lint:ci": "turbo run lint:ci",
    "format": "pnpm -r run format",
    "type-check": "turbo run type-check",
    "test": "NODE_OPTIONS='--max-old-space-size=4096' turbo run test",
    "test:a11y": "turbo run test:a11y --filter=react-lgpd-consent",
    "test:coverage": "turbo run test:coverage --filter=react-lgpd-consent",
    "coverage-check": "pnpm --filter react-lgpd-consent coverage-check",
    "coverage:analyze": "bash scripts/coverage-analysis.sh",
    "size-check": "pnpm --filter react-lgpd-consent size-check",
    "mutation": "npx stryker run stryker.conf.json",
    "mutation:tests": "npx stryker run stryker.tests.conf.json",
    "docs:generate": "turbo run docs:generate",
    "storybook": "turbo run storybook",
    "build-storybook": "turbo run build-storybook",
    "changeset": "changeset",
    "changeset:interactive": "pnpm exec tsx scripts/changeset-interactive.ts",
    "changeset:version": "changeset version && node scripts/sync-versions.mjs && pnpm install --lockfile-only",
    "changeset:publish": "changeset publish",
    "release": "turbo run build lint test && changeset publish"
  },
  "devDependencies": {
    "@axe-core/react": "^4.13.0",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@chromatic-com/storybook": "5.3.1",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@eslint/compat": "2.1.1",
    "@eslint/js": "^9.39.5",
    "@mui/icons-material": "7.3.11",
    "@mui/material": "7.3.11",
    "@size-limit/preset-small-lib": "^14.0.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-vitest": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/jest-runner": "9.6.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/jest": "30.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/js-cookie": "3.0.6",
    "@types/node": "25.9.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "baseline-browser-mapping": "^2.11.24",
    "cross-env": "10.1.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jest": "29.16.6",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-storybook": "10.6.0",
    "globals": "^17.12.0",
    "jest": "30.5.1",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "30.5.1",
    "prettier": "3.9.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rimraf": "6.1.3",
    "size-limit": "^14.0.0",
    "storybook": "10.6.0",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "tsup": "8.5.1",
    "tsx": "^4.23.13",
    "turbo": "^2.10.13",
    "typedoc": "0.28.20",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  }
}
